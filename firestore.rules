rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && ('admin' in request.auth.token) && request.auth.token.admin == true;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- ENTITY VALIDATION HELPERS ---
    function isValidPerPrayerAdhanModes(m) {
      return m is map &&
             m.keys().hasOnly(['fajr', 'dhuhr', 'asr', 'maghrib', 'isha']) &&
             (!('fajr' in m) || m.fajr in ['FULL_ADHAN', 'TAKBIR_ONLY', 'GENTLE_CHIME', 'SILENT']) &&
             (!('dhuhr' in m) || m.dhuhr in ['FULL_ADHAN', 'TAKBIR_ONLY', 'GENTLE_CHIME', 'SILENT']) &&
             (!('asr' in m) || m.asr in ['FULL_ADHAN', 'TAKBIR_ONLY', 'GENTLE_CHIME', 'SILENT']) &&
             (!('maghrib' in m) || m.maghrib in ['FULL_ADHAN', 'TAKBIR_ONLY', 'GENTLE_CHIME', 'SILENT']) &&
             (!('isha' in m) || m.isha in ['FULL_ADHAN', 'TAKBIR_ONLY', 'GENTLE_CHIME', 'SILENT']);
    }

    function isValidUserSettings(data, userId) {
      return data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.preferredLanguage in ['ar', 'en', 'tr', 'ur'] &&
             data.themeMode in ['LIGHT', 'DARK', 'SYSTEM'] &&
             data.mushafPaper in ['WHITE', 'SEPIA', 'DARK'] &&
             (data.fontScale is number && data.fontScale >= 0.7 && data.fontScale <= 2.0) &&
             (data.lastReadPage is int && data.lastReadPage >= 1 && data.lastReadPage <= 604) &&
             (data.lastReadSurah is int && data.lastReadSurah >= 1 && data.lastReadSurah <= 114) &&
             (data.lastReadAyah is int && data.lastReadAyah >= 1 && data.lastReadAyah <= 286) &&
             data.preferredReciterId is string && data.preferredReciterId.size() >= 1 && data.preferredReciterId.size() <= 64 &&
             data.adhanEnabled is bool &&
             data.adhanVoiceId is string && data.adhanVoiceId.size() >= 1 && data.adhanVoiceId.size() <= 64 &&
             (!('perPrayerAdhanModes' in data) || isValidPerPrayerAdhanModes(data.perPrayerAdhanModes)) &&
             (!('customAdhanName' in data) || (data.customAdhanName is string && data.customAdhanName.size() <= 120)) &&
             data.calculationMethod in ['MWL', 'ISNA', 'UMM_AL_QURA', 'EGYPTIAN', 'KARACHI'] &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             (data.latitude is number && data.latitude >= -90 && data.latitude <= 90) &&
             (data.longitude is number && data.longitude >= -180 && data.longitude <= 180) &&
             (data.hijriOffset is int && data.hijriOffset >= -2 && data.hijriOffset <= 2) &&
             data.travelerMode is bool &&
             data.ramadanMode is bool &&
             data.kidsMode is bool &&
             (data.qadaFajr is int && data.qadaFajr >= 0 && data.qadaFajr <= 100000) &&
             (data.qadaDhuhr is int && data.qadaDhuhr >= 0 && data.qadaDhuhr <= 100000) &&
             (data.qadaAsr is int && data.qadaAsr >= 0 && data.qadaAsr <= 100000) &&
             (data.qadaMaghrib is int && data.qadaMaghrib >= 0 && data.qadaMaghrib <= 100000) &&
             (data.qadaIsha is int && data.qadaIsha >= 0 && data.qadaIsha <= 100000) &&
             (data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000) &&
             (data.khatmahPagesRead is int && data.khatmahPagesRead >= 0 && data.khatmahPagesRead <= 604) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPrayerLog(data, dateKey) {
      return data.dateKey is string && data.dateKey == dateKey &&
             data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.fajr is bool &&
             data.dhuhr is bool &&
             data.asr is bool &&
             data.maghrib is bool &&
             data.isha is bool &&
             data.sunnahRawatib is bool &&
             data.duha is bool &&
             data.witr is bool &&
             data.qiyam is bool &&
             data.fastingType in ['NONE', 'VOLUNTARY', 'RAMADAN', 'QADA'] &&
             (data.khushuRating is int && data.khushuRating >= 0 && data.khushuRating <= 5) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidJournalEntry(data) {
      return data.entryType in ['DUA', 'VERSE_NOTE', 'GRATITUDE'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 2000 &&
             (!('reference' in data) || (data.reference is string && data.reference.size() <= 120)) &&
             data.answered is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBookmark(data) {
      return data.surahNumber is int && data.surahNumber >= 1 && data.surahNumber <= 114 &&
             data.ayahNumber is int && data.ayahNumber >= 1 && data.ayahNumber <= 286 &&
             (!('pageNumber' in data) || (data.pageNumber is int && data.pageNumber >= 1 && data.pageNumber <= 604)) &&
             data.collectionName is string && data.collectionName.size() >= 1 && data.collectionName.size() <= 60 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTasbihCounter(data) {
      return data.label is string && data.label.size() >= 1 && data.label.size() <= 80 &&
             data.arabicText is string && data.arabicText.size() <= 200 &&
             data.count is int && data.count >= 0 && data.count <= 10000000 &&
             data.target is int && data.target >= 1 && data.target <= 100000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidObligation(data) {
      return data.kind in ['CHARITY', 'DEBT', 'WASIYYAH'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.amount is number && data.amount >= 0 && data.amount <= 1000000000 &&
             data.settled is bool &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAdhkarLog(data) {
      return data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             data.completedCount is int && data.completedCount >= 0 && data.completedCount <= 10000 &&
             data.targetCount is int && data.targetCount >= 1 && data.targetCount <= 10000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAiChatMessage(data) {
      return data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 8000 &&
             (!('surahRef' in data) || (data.surahRef is string && data.surahRef.size() <= 64)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidReciter(data) {
      return data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 100 &&
             data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 100 &&
             data.styleAr is string && data.styleAr.size() <= 60 &&
             data.styleEn is string && data.styleEn.size() <= 60 &&
             data.editionId is string && data.editionId.size() >= 1 && data.editionId.size() <= 80 &&
             data.everyAyahFolder is string && data.everyAyahFolder.size() >= 1 && data.everyAyahFolder.size() <= 120 &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAdminConfig(data) {
      return data.configKey is string && data.configKey.size() >= 1 && data.configKey.size() <= 80 &&
             data.valueJson is string && data.valueJson.size() <= 8000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAdhanVoice(data) {
      return data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 100 &&
             data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 100 &&
             data.muezzin is string && data.muezzin.size() >= 1 && data.muezzin.size() <= 100 &&
             data.audioUrl is string && data.audioUrl.size() >= 1 && data.audioUrl.size() <= 500 &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAdhkarItem(data) {
      return data.category in ['MORNING', 'EVENING', 'AFTER_PRAYER', 'SLEEP', 'WAKING_UP', 'MOSQUE', 'TRAVEL', 'HOME_FOOD', 'RUQYAH', 'QURANIC_DUAS', 'PROPHETIC_DUAS', 'GENERAL_DUAS'] &&
             data.titleAr is string && data.titleAr.size() >= 1 && data.titleAr.size() <= 160 &&
             data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 160 &&
             data.arabic is string && data.arabic.size() >= 1 && data.arabic.size() <= 4000 &&
             data.transliteration is string && data.transliteration.size() <= 4000 &&
             data.translation is string && data.translation.size() <= 4000 &&
             data.targetCount is int && data.targetCount >= 1 && data.targetCount <= 1000 &&
             data.referenceAr is string && data.referenceAr.size() <= 400 &&
             data.referenceEn is string && data.referenceEn.size() <= 400 &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDuaWallPost(data) {
      return data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
             data.alias is string && data.alias.size() >= 1 && data.alias.size() <= 40 &&
             data.category in ['HEALING', 'GUIDANCE', 'SUSTENANCE', 'FAMILY', 'DECEASED', 'GENERAL'] &&
             data.requestText is string && data.requestText.size() >= 5 && data.requestText.size() <= 500 &&
             data.visibility == 'COMMUNITY' &&
             data.ameenCount is int && data.ameenCount >= 0 && data.ameenCount <= 1000000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidKhatmahGroup(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.joinCode is string && data.joinCode.size() >= 4 && data.joinCode.size() <= 12 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 20 &&
             data.memberUids[0] is string &&
             data.completedJuz is list && data.completedJuz.size() <= 30 &&
             (data.completedJuz.size() == 0 || data.completedJuz[0] is int) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- USER PROFILE & SUBCOLLECTIONS ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'preferredLanguage', 'themeMode', 'mushafPaper', 'fontScale',
                         'lastReadPage', 'lastReadSurah', 'lastReadAyah', 'preferredReciterId', 'adhanEnabled', 'adhanVoiceId',
                         'calculationMethod', 'city', 'latitude', 'longitude', 'hijriOffset', 'travelerMode', 'ramadanMode',
                         'kidsMode', 'qadaFajr', 'qadaDhuhr', 'qadaAsr', 'qadaMaghrib', 'qadaIsha', 'streakDays',
                         'khatmahPagesRead', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'preferredLanguage', 'themeMode', 'mushafPaper', 'fontScale',
                         'lastReadPage', 'lastReadSurah', 'lastReadAyah', 'preferredReciterId', 'adhanEnabled', 'adhanVoiceId',
                         'perPrayerAdhanModes', 'customAdhanName',
                         'calculationMethod', 'city', 'latitude', 'longitude', 'hijriOffset', 'travelerMode', 'ramadanMode',
                         'kidsMode', 'qadaFajr', 'qadaDhuhr', 'qadaAsr', 'qadaMaghrib', 'qadaIsha', 'streakDays',
                         'khatmahPagesRead', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserSettings(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserSettings(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'preferredLanguage', 'themeMode', 'mushafPaper', 'fontScale',
                         'lastReadPage', 'lastReadSurah', 'lastReadAyah', 'preferredReciterId', 'adhanEnabled', 'adhanVoiceId',
                         'perPrayerAdhanModes', 'customAdhanName',
                         'calculationMethod', 'city', 'latitude', 'longitude', 'hijriOffset', 'travelerMode', 'ramadanMode',
                         'kidsMode', 'qadaFajr', 'qadaDhuhr', 'qadaAsr', 'qadaMaghrib', 'qadaIsha', 'streakDays',
                         'khatmahPagesRead', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /prayerLogs/{dateKey} {
        allow get: if isOwner(userId) && isValidId(dateKey);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(dateKey) &&
                         incoming().keys().hasAll(['dateKey', 'fajr', 'dhuhr', 'asr', 'maghrib', 'isha', 'sunnahRawatib', 'duha', 'witr', 'qiyam', 'fastingType', 'khushuRating', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['dateKey', 'fajr', 'dhuhr', 'asr', 'maghrib', 'isha', 'sunnahRawatib', 'duha', 'witr', 'qiyam', 'fastingType', 'khushuRating', 'createdAt', 'updatedAt']) &&
                         isValidPrayerLog(incoming(), dateKey);

        allow update: if isOwner(userId) &&
                         isValidId(dateKey) &&
                         isValidPrayerLog(incoming(), dateKey) &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['fajr', 'dhuhr', 'asr', 'maghrib', 'isha', 'sunnahRawatib', 'duha', 'witr', 'qiyam', 'fastingType', 'khushuRating', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(dateKey);
      }

      match /duaJournal/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(entryId) &&
                         incoming().keys().hasAll(['entryType', 'title', 'body', 'answered', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['entryType', 'title', 'body', 'reference', 'answered', 'createdAt', 'updatedAt']) &&
                         isValidJournalEntry(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(entryId) &&
                         isValidJournalEntry(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['entryType', 'title', 'body', 'reference', 'answered', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(entryId);
      }

      match /bookmarks/{bookmarkId} {
        allow get: if isOwner(userId) && isValidId(bookmarkId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(bookmarkId) &&
                         incoming().keys().hasAll(['surahNumber', 'ayahNumber', 'collectionName', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['surahNumber', 'ayahNumber', 'pageNumber', 'collectionName', 'note', 'createdAt', 'updatedAt']) &&
                         isValidBookmark(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(bookmarkId) &&
                         isValidBookmark(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['pageNumber', 'collectionName', 'note', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(bookmarkId);
      }

      match /tasbihCounters/{counterId} {
        allow get: if isOwner(userId) && isValidId(counterId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(counterId) &&
                         incoming().keys().hasAll(['label', 'arabicText', 'count', 'target', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['label', 'arabicText', 'count', 'target', 'createdAt', 'updatedAt']) &&
                         isValidTasbihCounter(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(counterId) &&
                         isValidTasbihCounter(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['label', 'arabicText', 'count', 'target', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(counterId);
      }

      match /obligations/{itemId} {
        allow get: if isOwner(userId) && isValidId(itemId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(itemId) &&
                         incoming().keys().hasAll(['kind', 'title', 'amount', 'settled', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['kind', 'title', 'amount', 'settled', 'notes', 'createdAt', 'updatedAt']) &&
                         isValidObligation(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(itemId) &&
                         isValidObligation(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['kind', 'title', 'amount', 'settled', 'notes', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      // Phase 2 prepared: Adhkar tracking logs
      match /adhkarLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll(['dateKey', 'category', 'completedCount', 'targetCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['dateKey', 'category', 'completedCount', 'targetCount', 'createdAt', 'updatedAt']) &&
                         isValidAdhkarLog(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(logId) &&
                         isValidAdhkarLog(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['completedCount', 'targetCount', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Phase 2 prepared: AI Chat history
      match /aiChats/{chatId} {
        allow get: if isOwner(userId) && isValidId(chatId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(chatId) &&
                         incoming().keys().hasAll(['role', 'content', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['role', 'content', 'surahRef', 'createdAt', 'updatedAt']) &&
                         isValidAiChatMessage(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(chatId) &&
                         isValidAiChatMessage(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['content', 'surahRef', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(chatId);
      }
    }

    // --- PHASE 1 & PHASE 3 DYNAMIC RECITERS CATALOG ---
    match /reciters/{reciterId} {
      allow get: if isSignedIn() && isValidId(reciterId);
      allow list: if isSignedIn() && existing().active == true;
      allow create, update: if isAdmin() && isValidId(reciterId) && isValidReciter(incoming());
      allow delete: if isAdmin() && isValidId(reciterId);
    }

    // --- PHASE 3 PREPARED ADMIN CONFIGS & ADHAN VOICES ---
    match /adminConfigs/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(configId) && isValidAdminConfig(incoming());
      allow delete: if isAdmin() && isValidId(configId);
    }

    match /adhanVoices/{voiceId} {
      allow get: if isSignedIn() && isValidId(voiceId);
      allow list: if isSignedIn() && existing().active == true;
      allow create, update: if isAdmin() && isValidId(voiceId) && isValidAdhanVoice(incoming());
      allow delete: if isAdmin() && isValidId(voiceId);
    }

    match /adhkarItems/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId);
      allow list: if isSignedIn() && existing().active == true;
      allow create, update: if isAdmin() && isValidId(itemId) && isValidAdhkarItem(incoming());
      allow delete: if isAdmin() && isValidId(itemId);
    }

    // --- COMMUNITY ANONYMOUS DUA WALL ---
    match /duaWall/{postId} {
      allow get: if isSignedIn() && isValidId(postId) && existing().visibility == 'COMMUNITY';
      allow list: if isSignedIn() && existing().visibility == 'COMMUNITY';

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().authorUid == request.auth.uid &&
                       incoming().ameenCount == 0 &&
                       incoming().keys().hasAll(['authorUid', 'alias', 'category', 'requestText', 'visibility', 'ameenCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['authorUid', 'alias', 'category', 'requestText', 'visibility', 'ameenCount', 'createdAt', 'updatedAt']) &&
                       isValidDuaWallPost(incoming());

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidDuaWallPost(incoming()) &&
                       incoming().authorUid == existing().authorUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (incoming().diff(existing()).affectedKeys().hasOnly(['ameenCount', 'updatedAt']) &&
                          incoming().ameenCount == existing().ameenCount + 1) ||
                         (existing().authorUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['alias', 'category', 'requestText', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(postId) && existing().authorUid == request.auth.uid;
    }

    // --- FAMILY KHATMAH GROUPS ---
    match /khatmahGroups/{groupId} {
      allow get: if isSignedIn() && isValidId(groupId) && request.auth.uid in existing().memberUids;
      allow list: if isSignedIn() && request.auth.uid in existing().memberUids;

      allow create: if isSignedIn() &&
                       isValidId(groupId) &&
                       incoming().ownerUid == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().keys().hasAll(['ownerUid', 'title', 'joinCode', 'memberUids', 'completedJuz', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerUid', 'title', 'joinCode', 'memberUids', 'completedJuz', 'createdAt', 'updatedAt']) &&
                       isValidKhatmahGroup(incoming());

      allow update: if isSignedIn() &&
                       isValidId(groupId) &&
                       isValidKhatmahGroup(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().joinCode == existing().joinCode &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (request.auth.uid in existing().memberUids &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['completedJuz', 'title', 'updatedAt'])) ||
                         (!(request.auth.uid in existing().memberUids) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
                          incoming().memberUids.hasAll(existing().memberUids) &&
                          incoming().memberUids.size() == existing().memberUids.size() + 1 &&
                          request.auth.uid in incoming().memberUids)
                       );

      allow delete: if isSignedIn() && isValidId(groupId) && existing().ownerUid == request.auth.uid;
    }
  }
}
